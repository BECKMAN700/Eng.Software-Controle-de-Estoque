{
    "name": "uft/controle-de-estoque",
    "description": "Sistema de Controle de Estoque em PHP nativo (Engenharia de Software - UFT 2026.1).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "scripts": {
        "test": "@php vendor/phpunit/phpunit/phpunit",
        "test-unit": "@php vendor/phpunit/phpunit/phpunit --testsuite Unitarios",
        "test-feature": "@php vendor/phpunit/phpunit/phpunit --testsuite Feature"
    },
    "config": {
        "sort-packages": true
    }
}
